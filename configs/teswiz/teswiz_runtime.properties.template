# Copy this file to teswiz_runtime.properties and set TESWIZ_RUNTIME_CONFIG_FILE to its path.
# Built-in values are shown below. Uncomment and change only the values you need.

# Driver waits and retries
#TESWIZ_DRIVER_WAIT_TIMEOUT_SECONDS=10
#TESWIZ_DRIVER_CLICK_RETRY_ATTEMPTS=3
#TESWIZ_DRIVER_CLICK_RETRY_DELAY_SECONDS=1
#TESWIZ_DRIVER_SCROLL_MAX_ATTEMPTS=15

# Visual and Playwright defaults
#TESWIZ_DRIVER_VIEWPORT_WIDTH=1280
#TESWIZ_DRIVER_VIEWPORT_HEIGHT=960
#TESWIZ_PLAYWRIGHT_PAGE_LOAD_TIMEOUT_SECONDS=30
#TESWIZ_PLAYWRIGHT_SCRIPT_TIMEOUT_SECONDS=30

# Parallel driver limits
#TESWIZ_MAX_NUMBER_OF_APPIUM_DRIVERS=5
#TESWIZ_MAX_NUMBER_OF_WEB_DRIVERS=5

# Remote app URL operations
#TESWIZ_APP_DOWNLOAD_TIMEOUT_SECONDS=15
