# Canonical Teswiz execution configuration template.
# Copy this file, then uncomment and update the values needed for your execution.
# Runtime tuning values are documented separately in teswiz_runtime.properties.template.

# Execution mode
FRAMEWORK=cucumber
#CAPS=./caps/<app>/<capabilities>.json

# Application and web settings
#APP_NAME=teswiz
#APP_PACKAGE_NAME=<android-package-name>
#APP_PATH=./temp/<app>.apk
#BASE_URL_FOR_WEB=BASE_URL
BROWSER=chrome
#BROWSER_NAME=safari # Legacy alias used by older sample configurations
WEB_ENGINE=selenium
#PLATFORM=android

# Test data and environment
ENVIRONMENT_CONFIG_FILE=./src/test/resources/environments.json
#TARGET_ENVIRONMENT=prod
#TEST_DATA_FILE=./src/test/resources/testData.json
#TAG=@tag
#BRANCH_NAME=BUILD_SOURCEBRANCH
#BUILD_ID=BUILDID
#BUILD_INITIATION_REASON=BUILD_REASON

# Reports and logging
LOG_DIR=target
LOG_PROPERTIES_FILE=./src/test/resources/log4j2.properties
REPORT_PORTAL_FILE=./src/test/resources/reportportal.properties
RP_DESCRIPTION=custom description
#LAUNCH_NAME_SUFFIX= on 'prod' Environment

# Execution controls
PARALLEL=1
RUN_IN_CI=false
IS_FAILING_TEST_SUITE=false
SET_HARD_GATE=false
HEADLESS=false

# Visual testing
IS_VISUAL=false
FAIL_TEST_ON_VISUAL_DIFFERENCE=true
APPLITOOLS_CONFIGURATION=./configs/applitools_config.json
#APPLITOOLS_API_KEY=<applitools-api-key>
#APPLITOOLS_BATCH_NAME_SUFFIX= - #<build-number>
#HIGHLIGHT_ELEMENTS=true
#HIGHLIGHT_COLOR=#FF0000
#HIGHLIGHT_BORDER_WIDTH=3px
#IS_OCR_ENABLED=false
#VISUAL_CONFIDENCE_THRESHOLD=0.85
#VISUAL_ELEMENT_RETRY_ATTEMPTS=3
#VISUAL_ELEMENT_RETRY_DELAY_SECONDS=1
#VISUAL_ACTION_WAIT_SECONDS=1

# LLM vision fallback: last-resort element location when OCR + image recognition both fail.
# Opt-in via driver.findByDescription(...) / findByTextOrImageOrDescription(...). HTTP calls reuse
# the configured API_ENGINE. Requires IS_OCR_ENABLED=true. When enabled, endpoint + API key are
# validated at startup (including a lightweight auth health-check) so misconfiguration fails fast.
#LLM_VISION_FALLBACK_ENABLED=false
# Provider: openai | azure-openai | anthropic | gemini | vertex-gemini | groq | xai | openrouter |
# ollama | bedrock | custom (any OpenAI-compatible chat-completions endpoint).
#LLM_VISION_PROVIDER=openai
# Model id. Optional for openai/azure-openai/anthropic/gemini/vertex-gemini (defaults apply);
# MANDATORY for groq, xai, openrouter, ollama, and bedrock (startup fails fast if blank).
#LLM_VISION_MODEL=
#LLM_VISION_ENDPOINT=<llm-vision-chat-completions-endpoint>
# ENV VAR name holding the API key (never the key itself). Not required for vertex-gemini (Google
# Application Default Credentials) or ollama (local server). bedrock uses a Bedrock API key here.
#LLM_VISION_API_KEY_ENV=LLM_VISION_API_KEY
# Azure OpenAI only: the api-version appended to the endpoint. Default 2024-06-01.
#LLM_VISION_API_VERSION=2024-06-01
#LLM_VISION_MAX_RETRIES=1
#LLM_VISION_TIMEOUT_SECONDS=30
#LLM_VISION_LOG_API_TRAFFIC=true
#LLM_VISION_SAVE_CAPTURES=true

# Device and remote execution
MAX_NUMBER_OF_APPIUM_DRIVERS=5
MAX_NUMBER_OF_WEB_DRIVERS=5
#CLOUD_USERNAME=<cloud-username>
#CLOUD_KEY=<cloud-access-key>
#CLOUD_NAME=browserstack # Optional provider name
CLOUD_UPLOAD_APP=false
CLOUD_USE_PROXY=false
CLOUD_USE_LOCAL_TESTING=false
PROXY_KEY=HTTP_PROXY
#PROXY_URL=<proxy-url>
REMOTE_WEBDRIVER_GRID_HOST_NAME=localhost
REMOTE_WEBDRIVER_GRID_PORT=4444

# Data masking
SHOW_SENSITIVE_DATA=false
#MASK_ADDITIONAL_KEYS=sessionId,customerId
#MASK_KEYS_OVERRIDE=password,token

# API execution & traffic logging
#API_ENGINE=rest-assured
#API_MAX_RETRIES=3
#API_TRAFFIC_LOGGING=true
#STEP_ATTRIBUTION_ENABLED=true

# Usage Telemetry & Analytics
# Values: enabled | enabled-masked (default) | disabled
#ENABLE_USAGE_ANALYTICS=enabled-masked
#ORGANIZATION_NAME=<organization-name>
#TELEMETRY_ENDPOINT=https://us.i.posthog.com/capture/
#TELEMETRY_API_KEY=<telemetry-api-key>

# Runtime defaults. System properties and environment variables override these values.
#TESWIZ_RUNTIME_CONFIG_FILE=./configs/teswiz/teswiz_runtime.properties
#TESWIZ_DRIVER_WAIT_TIMEOUT_SECONDS=10
#TESWIZ_DRIVER_CLICK_RETRY_ATTEMPTS=3
#TESWIZ_DRIVER_CLICK_RETRY_DELAY_SECONDS=1
#TESWIZ_DRIVER_SCROLL_MAX_ATTEMPTS=15
#TESWIZ_DRIVER_VIEWPORT_WIDTH=1280
#TESWIZ_DRIVER_VIEWPORT_HEIGHT=960
#TESWIZ_PLAYWRIGHT_PAGE_LOAD_TIMEOUT_SECONDS=30
#TESWIZ_PLAYWRIGHT_SCRIPT_TIMEOUT_SECONDS=30
#TESWIZ_API_TIMEOUT_SECONDS=60
#TESWIZ_MAX_NUMBER_OF_APPIUM_DRIVERS=5
#TESWIZ_MAX_NUMBER_OF_WEB_DRIVERS=5
#TESWIZ_APP_DOWNLOAD_TIMEOUT_SECONDS=15

